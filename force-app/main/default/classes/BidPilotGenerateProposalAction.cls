public with sharing class BidPilotGenerateProposalAction {

    public class Request {
        @InvocableVariable(label='Bid Reference' description='Bid number (e.g. BID-0001) or Bid record Id' required=true)
        public String bidReference;
    }

    public class Response {
        @InvocableVariable(label='Opportunity Id' description='Opportunity created or updated for the bid')
        public Id opportunityId;
        @InvocableVariable(label='Proposal Summary' description='Proposal summary text')
        public String proposalSummary;
        @InvocableVariable(label='Client Email Draft' description='Draft email to send to the client')
        public String emailDraft;
        @InvocableVariable(label='Message' description='Result of the action')
        public String message;
    }

    @InvocableMethod(
        label='BidPilot: Generate Proposal'
        description='For an approved bid, creates the Account, Opportunity and delivery Tasks, and writes the proposal summary and client email draft. Will refuse if the bid is not approved.'
        category='BidPilot')
    public static List<Response> run(List<Request> requests) {
        List<Response> out = new List<Response>();
        for (Request r : requests) {
            Response res = new Response();
            Savepoint sp = Database.setSavepoint();
            try {
                Bid__c b = BidPilotService.getBid(BidPilotService.resolveBidId(r.bidReference));
                if (b.Status__c != 'Approved' && b.Status__c != 'Proposal Ready') {
                    res.message = b.Name + ' is "' + b.Status__c + '". It must be approved before a proposal can be generated.';
                    out.add(res);
                    continue;
                }

                Boolean isNew = b.Opportunity__c == null;
                Opportunity opp = isNew ? new Opportunity() : new Opportunity(Id = b.Opportunity__c);
                opp.Name = (b.Client_Name__c + ' - ' + b.Project_Title__c).left(120);
                opp.Amount = b.Estimated_Cost__c;
                opp.StageName = proposalStage();
                opp.CloseDate = Date.today().addDays(30);
                opp.Description = 'Generated by BidPilot from ' + b.Name;
                if (isNew) opp.AccountId = accountFor(b.Client_Name__c);
                upsert opp;

                if (isNew) {
                    List<Task> plan = new List<Task>();
                    Date due = Date.today();
                    for (Bid_Module__c m : b.Modules__r) {
                        Integer days = (m.Effort_Hours__c == null) ? 5 : Math.max(1, (m.Effort_Hours__c / 8).intValue());
                        due = due.addDays(days);
                        plan.add(new Task(
                            WhatId = opp.Id,
                            Subject = 'Deliver: ' + m.Name,
                            Description = m.Complexity__c + ' | ' + m.Skill__c + ' | ' + m.Effort_Hours__c + 'h'
                                + (String.isBlank(m.Description__c) ? '' : '\n' + m.Description__c),
                            ActivityDate = due,
                            Status = 'Not Started',
                            Priority = m.Complexity__c == 'High' ? 'High' : 'Normal'
                        ));
                    }
                    insert plan;
                }

                String summary = BidPilotService.buildProposal(b);
                String email = BidPilotService.buildEmail(b);
                update new Bid__c(Id = b.Id, Opportunity__c = opp.Id, Status__c = 'Proposal Ready',
                    Proposal_Summary__c = summary, Client_Email_Draft__c = email);

                res.opportunityId = opp.Id;
                res.proposalSummary = summary;
                res.emailDraft = email;
                res.message = 'Proposal ready for ' + b.Name + '. Opportunity "' + opp.Name + '" (' + BidPilotService.inr(opp.Amount)
                    + ') ' + (isNew ? 'created with ' + b.Modules__r.size() + ' delivery tasks.' : 'updated.');
            } catch (Exception e) {
                Database.rollback(sp);
                res.message = 'Could not generate the proposal: ' + e.getMessage();
            }
            out.add(res);
        }
        return out;
    }

    private static Id accountFor(String name) {
        String n = String.isBlank(name) ? 'Unknown Client' : name.left(255);
        List<Account> found = [SELECT Id FROM Account WHERE Name = :n LIMIT 1];
        if (!found.isEmpty()) return found[0].Id;
        Account a = new Account(Name = n);
        insert a;
        return a.Id;
    }

    private static String proposalStage() {
        List<OpportunityStage> stages = [
            SELECT ApiName, MasterLabel FROM OpportunityStage
            WHERE IsActive = true AND IsClosed = false ORDER BY SortOrder
        ];
        for (OpportunityStage s : stages) {
            if (s.MasterLabel.containsIgnoreCase('proposal') || s.MasterLabel.containsIgnoreCase('quote')) return s.ApiName;
        }
        return stages.isEmpty() ? 'Prospecting' : stages[stages.size() - 1].ApiName;
    }
}
